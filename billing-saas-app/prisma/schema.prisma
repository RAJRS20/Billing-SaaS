// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// SaaS / Platform Layer
// ─────────────────────────────────────────────────────────────────────────────

model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String   @unique // Basic, Professional, Enterprise
  slug          String   @unique
  price         Decimal  @db.Decimal(10, 2)
  billingCycle  String   @default("MONTHLY") // MONTHLY | YEARLY
  maxUsers      Int      @default(5)
  maxBranches   Int      @default(1)
  maxInvoices   Int      @default(1000) // per month
  features      Json     @default("[]")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  subscriptions Subscription[]
}

model Tenant {
  id            String        @id @default(cuid())
  name          String        // Shop/Business name
  email         String        @unique
  phone         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  gstin         String?       // GST Identification Number
  panNumber     String?
  logoUrl       String?
  isActive      Boolean       @default(true)
  trialEndsAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  branches      Branch[]
  users         User[]
  customers     Customer[]
  suppliers     Supplier[]
  metals        Metal[]
  purities      Purity[]
  categories    ProductCategory[]
  products      Product[]
  goldRates     GoldRate[]
  sales         Sale[]
  purchases     Purchase[]
  expenses      Expense[]
  expenseCategories ExpenseCategory[]
  oldGoldTxns   OldGoldTransaction[]
  estimates     Estimate[]
  orders        Order[]
  auditLogs     AuditLog[]
  inventory     Inventory[]
  inventoryTxns InventoryTransaction[]
  stockAdjustments StockAdjustment[]
  subscriptions Subscription[]
  invoiceSequences InvoiceSequence[]
  accounts      Account[]
  journalEntries JournalEntry[]
  karigars      Karigar[]
  jobWorks      JobWork[]
  hallmarkRequests HallmarkRequest[]
  repairTickets RepairTicket[]
  shifts        Shift[]
  dayClosings   DayClosing[]
  storeSetting  StoreSetting?
}

model Subscription {
  id          String           @id @default(cuid())
  tenantId    String
  planId      String
  status      String           @default("TRIAL") // TRIAL | ACTIVE | GRACE | EXPIRED | CANCELLED
  startedAt   DateTime         @default(now())
  expiresAt   DateTime?
  razorpaySubscriptionId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
  payments    SubscriptionPayment[]
}

model SubscriptionPayment {
  id             String       @id @default(cuid())
  subscriptionId String
  amount         Decimal      @db.Decimal(10, 2)
  currency       String       @default("INR")
  status         String       // SUCCESS | FAILED | PENDING
  razorpayPaymentId String?
  paidAt         DateTime?
  createdAt      DateTime     @default(now())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Shop / Organizational Structure
// ─────────────────────────────────────────────────────────────────────────────

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  users     User[]
  products  Product[]
  inventory Inventory[]
  sales     Sale[]
  purchases Purchase[]
  transfers StockTransferFrom[] @relation("FromBranch")
  transfersTo StockTransferTo[] @relation("ToBranch")
  shifts      Shift[]
  dayClosings DayClosing[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  tenantId     String?  // null = Super Admin
  branchId     String?
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true)
  isSuperAdmin Boolean  @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  branch       Branch?  @relation(fields: [branchId], references: [id])
  sales        Sale[]
  auditLogs    AuditLog[]
  goldRates    GoldRate[]
  shifts       Shift[]    @relation("ShiftUser")
  approvedShifts Shift[]  @relation("ShiftApprover")
}

enum UserRole {
  SUPER_ADMIN
  SHOP_OWNER
  MANAGER
  CASHIER
  ACCOUNTANT
  STAFF
}

// ─────────────────────────────────────────────────────────────────────────────
// Jewellery Master Data
// ─────────────────────────────────────────────────────────────────────────────

model Metal {
  id        String    @id @default(cuid())
  tenantId  String
  name      String    // Gold, Silver, Platinum
  symbol    String    // AU, AG, PT
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  purities  Purity[]
  goldRates GoldRate[]
  products  Product[]

  @@unique([tenantId, symbol])
}

model Purity {
  id          String   @id @default(cuid())
  tenantId    String
  metalId     String
  name        String   // 24K, 22K, 18K, 14K, 92.5 Silver
  fineness    Decimal  @db.Decimal(7, 4) // 0.9999 for 24K, 0.9166 for 22K
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  metal       Metal    @relation(fields: [metalId], references: [id])
  goldRates   GoldRate[]
  products    Product[]

  @@unique([tenantId, metalId, name])
}

model ProductCategory {
  id        String    @id @default(cuid())
  tenantId  String
  name      String    // Necklace, Ring, Earring, Bangle, Chain, Pendant
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  products  Product[]

  @@unique([tenantId, name])
}

model Product {
  id                  String    @id @default(cuid())
  tenantId            String
  branchId            String?
  categoryId          String
  metalId             String
  purityId            String
  sku                 String
  name                String
  description         String?
  barcode             String?
  huid                String?   // Hallmark Unique ID
  bisHallmark         String?

  // Weight (all in grams)
  grossWeight         Decimal   @db.Decimal(10, 3)
  stoneWeight         Decimal   @db.Decimal(10, 3) @default(0)
  netWeight           Decimal   @db.Decimal(10, 3) // grossWeight - stoneWeight

  // Making Charges
  makingChargeType    MakingChargeType @default(PER_GRAM)
  makingChargeValue   Decimal   @db.Decimal(10, 2) @default(0)

  // Wastage
  wastageType         WastageType @default(PERCENTAGE)
  wastageValue        Decimal   @db.Decimal(7, 3) @default(0)

  // Stone charges
  stoneChargeFixed    Decimal   @db.Decimal(10, 2) @default(0)
  stoneChargeDesc     String?

  // Cost
  purchaseCost        Decimal?  @db.Decimal(10, 2)

  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  branch              Branch?   @relation(fields: [branchId], references: [id])
  category            ProductCategory @relation(fields: [categoryId], references: [id])
  metal               Metal     @relation(fields: [metalId], references: [id])
  purity              Purity    @relation(fields: [purityId], references: [id])
  inventory           Inventory[]
  saleItems           SaleItem[]
  purchaseItems       PurchaseItem[]
  estimateItems       EstimateItem[]

  @@unique([tenantId, sku])
}

enum MakingChargeType {
  PER_GRAM
  PERCENTAGE
  FIXED
}

enum WastageType {
  WEIGHT_GRAMS
  PERCENTAGE
}

// ─────────────────────────────────────────────────────────────────────────────
// Gold Rate Engine
// ─────────────────────────────────────────────────────────────────────────────

model GoldRate {
  id          String   @id @default(cuid())
  tenantId    String
  metalId     String
  purityId    String
  ratePerGram Decimal  @db.Decimal(10, 2)
  effectiveAt DateTime @default(now())
  updatedById String
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  metal       Metal    @relation(fields: [metalId], references: [id])
  purity      Purity   @relation(fields: [purityId], references: [id])
  updatedBy   User     @relation(fields: [updatedById], references: [id])

  @@index([tenantId, purityId, effectiveAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Customers & Suppliers
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  phone       String
  email       String?
  address     String?
  city        String?
  gstin       String?
  panNumber   String?
  dob         DateTime?
  anniversary DateTime?
  notes       String?
  creditLimit Decimal   @db.Decimal(10, 2) @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  sales       Sale[]
  advances    Advance[]
  orders      Order[]
  estimates   Estimate[]
  repairTickets RepairTicket[]

  @@unique([tenantId, phone])
}

model Supplier {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  phone     String
  email     String?
  address   String?
  gstin     String?
  panNumber String?
  notes     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  purchases Purchase[]

  @@unique([tenantId, phone])
}

// ─────────────────────────────────────────────────────────────────────────────
// Inventory
// ─────────────────────────────────────────────────────────────────────────────

model Inventory {
  id          String   @id @default(cuid())
  tenantId    String
  branchId    String
  productId   String
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  branch      Branch   @relation(fields: [branchId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@unique([tenantId, branchId, productId])
}

model InventoryTransaction {
  id                 String     @id @default(cuid())
  tenantId           String
  productId          String
  branchId           String
  inventoryId        String?
  type               InvTxnType
  quantityChange     Int        // positive = in, negative = out
  grossWeightChange  Decimal    @db.Decimal(10, 3) @default(0)
  stoneWeightChange  Decimal    @db.Decimal(10, 3) @default(0)
  netWeightChange    Decimal    @db.Decimal(10, 3) @default(0)
  purityName         String?
  purityFineness     Decimal?   @db.Decimal(7, 4)
  referenceId        String?    // saleId, purchaseId, adjustmentId
  referenceType      String?    // SALE | PURCHASE | ADJUSTMENT | TRANSFER | RETURN | KARIGAR | OLD_GOLD
  reason             String?
  userId             String?
  notes              String?
  createdAt          DateTime   @default(now())

  tenant             Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId, productId])
  @@index([tenantId, branchId, createdAt])
}

enum InvTxnType {
  PURCHASE_IN
  SALE_OUT
  SALE_RETURN_IN
  PURCHASE_RETURN_OUT
  OLD_GOLD_IN
  KARIGAR_ISSUE
  KARIGAR_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  MELTING
  SCRAP
  OPENING_STOCK
}

model StockAdjustment {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  branchId  String
  reason    String
  quantityBefore Int
  quantityAfter  Int
  notes     String?
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model StockTransferFrom {
  id        String   @id @default(cuid())
  branchId  String
  productId String
  quantity  Int
  createdAt DateTime @default(now())

  branch    Branch   @relation("FromBranch", fields: [branchId], references: [id])
}

model StockTransferTo {
  id        String   @id @default(cuid())
  branchId  String
  productId String
  quantity  Int
  createdAt DateTime @default(now())

  branch    Branch   @relation("ToBranch", fields: [branchId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Sales & Billing
// ─────────────────────────────────────────────────────────────────────────────

model InvoiceSequence {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  prefix      String   @default("INV")
  lastNumber  Int      @default(0)
  resetYearly Boolean  @default(true)
  resetYear   Int?

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

model Sale {
  id              String      @id @default(cuid())
  tenantId        String
  branchId        String
  customerId      String?
  invoiceNumber   String
  invoiceDate     DateTime    @default(now())
  goldRateSnapshot Json       // Rate at time of invoice {purityId: rate}

  // Totals
  grossAmount     Decimal     @db.Decimal(12, 2)
  discountAmount  Decimal     @db.Decimal(10, 2) @default(0)
  taxableAmount   Decimal     @db.Decimal(12, 2)
  cgstAmount      Decimal     @db.Decimal(10, 2) @default(0)
  sgstAmount      Decimal     @db.Decimal(10, 2) @default(0)
  igstAmount      Decimal     @db.Decimal(10, 2) @default(0)
  totalTaxAmount  Decimal     @db.Decimal(10, 2) @default(0)
  netAmount       Decimal     @db.Decimal(12, 2)
  advanceAdjusted Decimal     @db.Decimal(10, 2) @default(0)
  oldGoldAdjusted Decimal     @db.Decimal(10, 2) @default(0)
  amountPaid      Decimal     @db.Decimal(12, 2)
  amountDue       Decimal     @db.Decimal(12, 2) @default(0)

  status          SaleStatus  @default(COMPLETED)
  notes           String?
  createdById     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  branch          Branch      @relation(fields: [branchId], references: [id])
  customer        Customer?   @relation(fields: [customerId], references: [id])
  createdBy       User        @relation(fields: [createdById], references: [id])
  items           SaleItem[]
  payments        SalePayment[]
  returns         SaleReturn[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, invoiceDate])
}

enum SaleStatus {
  DRAFT
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
  CANCELLED
}

model SaleItem {
  id                String   @id @default(cuid())
  saleId            String
  productId         String

  // Snapshot at time of sale
  productName       String
  huid              String?
  barcode           String?
  categoryName      String
  metalName         String
  purityName        String
  grossWeight       Decimal  @db.Decimal(10, 3)
  stoneWeight       Decimal  @db.Decimal(10, 3)
  netWeight         Decimal  @db.Decimal(10, 3)
  wastageGrams      Decimal  @db.Decimal(10, 3)
  goldRatePerGram   Decimal  @db.Decimal(10, 2)

  goldValue         Decimal  @db.Decimal(12, 2)
  wastageValue      Decimal  @db.Decimal(10, 2)
  makingCharge      Decimal  @db.Decimal(10, 2)
  stoneCharge       Decimal  @db.Decimal(10, 2)
  itemGrossAmount   Decimal  @db.Decimal(12, 2)
  discountAmount    Decimal  @db.Decimal(10, 2)
  itemNetAmount     Decimal  @db.Decimal(12, 2)

  quantity          Int      @default(1)

  sale              Sale     @relation(fields: [saleId], references: [id])
  product           Product  @relation(fields: [productId], references: [id])
  returnItems       SaleReturnItem[]
}

model SalePayment {
  id            String        @id @default(cuid())
  saleId        String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  reference     String?       // UPI txn ID, cheque number, etc.
  paidAt        DateTime      @default(now())

  sale          Sale          @relation(fields: [saleId], references: [id])
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  CREDIT
  ADVANCE_ADJUSTMENT
  OLD_GOLD_ADJUSTMENT
}

model SaleReturn {
  id            String   @id @default(cuid())
  tenantId      String
  saleId        String
  returnDate    DateTime @default(now())
  reason        String?
  refundAmount  Decimal  @db.Decimal(10, 2)
  refundMethod  String?
  createdAt     DateTime @default(now())

  sale          Sale     @relation(fields: [saleId], references: [id])
  items         SaleReturnItem[]
}

model SaleReturnItem {
  id           String     @id @default(cuid())
  saleReturnId String
  saleItemId   String
  quantity     Int

  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id])
  saleItem     SaleItem   @relation(fields: [saleItemId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Purchases
// ─────────────────────────────────────────────────────────────────────────────

model Purchase {
  id             String    @id @default(cuid())
  tenantId       String
  branchId       String
  supplierId     String
  purchaseNumber String
  purchaseDate   DateTime  @default(now())
  grossAmount    Decimal   @db.Decimal(12, 2)
  taxAmount      Decimal   @db.Decimal(10, 2) @default(0)
  netAmount      Decimal   @db.Decimal(12, 2)
  amountPaid     Decimal   @db.Decimal(12, 2) @default(0)
  amountDue      Decimal   @db.Decimal(12, 2) @default(0)
  notes          String?
  status         PurchaseStatus @default(COMPLETED)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  branch         Branch    @relation(fields: [branchId], references: [id])
  supplier       Supplier  @relation(fields: [supplierId], references: [id])
  items          PurchaseItem[]
  payments       PurchasePayment[]
}

enum PurchaseStatus {
  DRAFT
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
}

model PurchaseItem {
  id           String   @id @default(cuid())
  purchaseId   String
  productId    String
  quantity     Int
  grossWeight  Decimal  @db.Decimal(10, 3)
  stoneWeight  Decimal  @db.Decimal(10, 3) @default(0)
  netWeight    Decimal  @db.Decimal(10, 3)
  ratePerGram  Decimal  @db.Decimal(10, 2)
  unitCost     Decimal  @db.Decimal(12, 2)
  totalCost    Decimal  @db.Decimal(12, 2)

  purchase     Purchase @relation(fields: [purchaseId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])
}

model PurchasePayment {
  id          String        @id @default(cuid())
  purchaseId  String
  method      PaymentMethod
  amount      Decimal       @db.Decimal(10, 2)
  reference   String?
  paidAt      DateTime      @default(now())

  purchase    Purchase      @relation(fields: [purchaseId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Old Gold Exchange
// ─────────────────────────────────────────────────────────────────────────────

model OldGoldTransaction {
  id                      String        @id @default(cuid())
  tenantId                String
  branchId                String?
  saleId                  String?       // If part of an exchange
  customerId              String?
  userId                  String?
  type                    OldGoldType   @default(EXCHANGE)
  status                  OldGoldStatus @default(APPROVED)
  purityName              String
  testedFineness          Decimal       @db.Decimal(7, 4) @default(0.9160)
  grossWeight             Decimal       @db.Decimal(10, 3)
  stoneWeight             Decimal       @db.Decimal(10, 3) @default(0)
  netWeight               Decimal       @db.Decimal(10, 3)
  pureGoldEquivalent      Decimal       @db.Decimal(10, 3) @default(0)
  meltingDeductionPercent Decimal       @db.Decimal(5, 2) @default(2.0)
  netPureWeight           Decimal       @db.Decimal(10, 3) @default(0)
  buyingRate24K           Decimal       @db.Decimal(10, 2) @default(0)
  ratePerGram             Decimal       @db.Decimal(10, 2)
  valuationAmount         Decimal       @db.Decimal(10, 2)
  notes                   String?
  createdAt               DateTime      @default(now())

  tenant                  Tenant        @relation(fields: [tenantId], references: [id])
}

enum OldGoldType {
  EXCHANGE
  CASH_PURCHASE
}

enum OldGoldStatus {
  PENDING
  APPROVED
  SETTLED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────────
// Estimates & Orders & Advances
// ─────────────────────────────────────────────────────────────────────────────

model Estimate {
  id             String         @id @default(cuid())
  tenantId       String
  customerId     String?
  estimateNumber String
  estimateDate   DateTime       @default(now())
  expiryDate     DateTime?
  goldRateSnapshot Json
  grossAmount    Decimal        @db.Decimal(12, 2)
  discountAmount Decimal        @db.Decimal(10, 2) @default(0)
  taxAmount      Decimal        @db.Decimal(10, 2) @default(0)
  netAmount      Decimal        @db.Decimal(12, 2)
  status         EstimateStatus @default(PENDING)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  customer       Customer?      @relation(fields: [customerId], references: [id])
  items          EstimateItem[]
}

enum EstimateStatus {
  PENDING
  APPROVED
  CONVERTED
  EXPIRED
  CANCELLED
}

model EstimateItem {
  id            String   @id @default(cuid())
  estimateId    String
  productId     String
  productName   String
  grossWeight   Decimal  @db.Decimal(10, 3)
  netWeight     Decimal  @db.Decimal(10, 3)
  goldRatePerGram Decimal @db.Decimal(10, 2)
  goldValue     Decimal  @db.Decimal(12, 2)
  makingCharge  Decimal  @db.Decimal(10, 2)
  stoneCharge   Decimal  @db.Decimal(10, 2)
  totalAmount   Decimal  @db.Decimal(12, 2)
  quantity      Int      @default(1)

  estimate      Estimate @relation(fields: [estimateId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])
}

model Order {
  id              String      @id @default(cuid())
  tenantId        String
  customerId      String
  orderNumber     String
  orderDate       DateTime    @default(now())
  expectedDate    DateTime?
  description     String
  estimatedAmount Decimal     @db.Decimal(12, 2)
  advancePaid     Decimal     @db.Decimal(10, 2) @default(0)
  balanceDue      Decimal     @db.Decimal(10, 2)
  status          OrderStatus @default(PENDING)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  customer        Customer    @relation(fields: [customerId], references: [id])
  advances        Advance[]
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

model Advance {
  id          String        @id @default(cuid())
  tenantId    String        // kept for quick tenant-scoped queries
  customerId  String
  orderId     String?
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod
  reference   String?
  notes       String?
  paidAt      DateTime      @default(now())
  isAdjusted  Boolean       @default(false)
  createdAt   DateTime      @default(now())

  customer    Customer      @relation(fields: [customerId], references: [id])
  order       Order?        @relation(fields: [orderId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Expenses
// ─────────────────────────────────────────────────────────────────────────────

model ExpenseCategory {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  expenses  Expense[]

  @@unique([tenantId, name])
}

model Expense {
  id          String          @id @default(cuid())
  tenantId    String
  categoryId  String
  amount      Decimal         @db.Decimal(10, 2)
  method      PaymentMethod
  description String
  reference   String?
  expenseDate DateTime        @default(now())
  createdAt   DateTime        @default(now())

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit Logs
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String
  action     String   // CREATE | UPDATE | DELETE | LOGIN | LOGOUT
  entity     String   // Sale | Product | GoldRate | User ...
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Financial Accounting (Double-Entry Journal)
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id          String        @id @default(cuid())
  tenantId    String
  code        String        // e.g. "1010" Cash, "1020" Bank, "1030" AR, "2010" AP, "4010" Sales, "5010" COGS
  name        String
  type        AccountType   // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  lines       JournalLine[]

  @@unique([tenantId, code])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model JournalEntry {
  id            String        @id @default(cuid())
  tenantId      String
  entryNumber   String
  date          DateTime      @default(now())
  description   String
  referenceId   String?       // saleId, purchaseId, expenseId, oldGoldTxnId
  referenceType String?       // SALE | PURCHASE | EXPENSE | OLD_GOLD | ADVANCE | REFUND
  createdAt     DateTime      @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  lines         JournalLine[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId, date])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal      @db.Decimal(12, 2) @default(0)
  credit         Decimal      @db.Decimal(12, 2) @default(0)

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Karigar / Job Work Operations
// ─────────────────────────────────────────────────────────────────────────────

model Karigar {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  phone     String
  address   String?
  skillType String?   // Handcraft, Casting, Setting, Polishing
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  jobWorks  JobWork[]

  @@unique([tenantId, phone])
}

model JobWork {
  id               String            @id @default(cuid())
  tenantId         String
  karigarId        String
  orderId          String?
  jobWorkNumber    String
  issueDate        DateTime          @default(now())
  expectedDate     DateTime?
  goldIssuedGrams  Decimal           @db.Decimal(10, 3)
  purityName       String
  status           JobWorkStatus     @default(ISSUED)
  notes            String?
  createdAt        DateTime          @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  karigar          Karigar           @relation(fields: [karigarId], references: [id])
  items            JobWorkItem[]
  settlement       JobWorkSettlement?

  @@unique([tenantId, jobWorkNumber])
}

enum JobWorkStatus {
  ISSUED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model JobWorkItem {
  id               String   @id @default(cuid())
  jobWorkId        String
  description      String
  grossWeightGrams Decimal  @db.Decimal(10, 3)
  stoneWeightGrams Decimal  @db.Decimal(10, 3) @default(0)
  netWeightGrams   Decimal  @db.Decimal(10, 3)

  jobWork          JobWork  @relation(fields: [jobWorkId], references: [id])
}

model JobWorkSettlement {
  id                String   @id @default(cuid())
  jobWorkId         String   @unique
  goldReturnedGrams Decimal  @db.Decimal(10, 3)
  scrapDustGrams    Decimal  @db.Decimal(10, 3) @default(0)
  processLossGrams  Decimal  @db.Decimal(10, 3) @default(0)
  makingChargesPaid Decimal  @db.Decimal(10, 2)
  settledAt         DateTime @default(now())

  jobWork           JobWork  @relation(fields: [jobWorkId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Hallmarking Management
// ─────────────────────────────────────────────────────────────────────────────

model HallmarkRequest {
  id               String         @id @default(cuid())
  tenantId         String
  requestNumber    String
  centreName       String
  submittedDate    DateTime       @default(now())
  receivedDate     DateTime?
  totalArticles    Int            @default(1)
  totalWeightGrams Decimal        @db.Decimal(10, 3)
  chargesAmount    Decimal        @db.Decimal(10, 2) @default(0)
  status           HallmarkStatus @default(SUBMITTED)
  createdAt        DateTime       @default(now())

  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  items            HallmarkItem[]

  @@unique([tenantId, requestNumber])
}

enum HallmarkStatus {
  SUBMITTED
  AT_CENTRE
  RECEIVED
  HUID_MAPPED
}

model HallmarkItem {
  id                String          @id @default(cuid())
  hallmarkRequestId String
  productId         String?
  articleName       String
  purityName        String
  grossWeightGrams  Decimal         @db.Decimal(10, 3)
  huid              String?
  isMapped          Boolean         @default(false)

  request           HallmarkRequest @relation(fields: [hallmarkRequestId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Repairs Management
// ─────────────────────────────────────────────────────────────────────────────

model RepairTicket {
  id               String       @id @default(cuid())
  tenantId         String
  customerId       String?
  ticketNumber     String
  articleName      String
  receivedWeight   Decimal      @db.Decimal(10, 3)
  issueDescription String
  estimatedCost    Decimal      @db.Decimal(10, 2) @default(0)
  advancePaid      Decimal      @db.Decimal(10, 2) @default(0)
  status           RepairStatus @default(RECEIVED)
  receivedDate     DateTime     @default(now())
  deliveredDate    DateTime?
  notes            String?

  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  customer         Customer?    @relation(fields: [customerId], references: [id])

  @@unique([tenantId, ticketNumber])
}

enum RepairStatus {
  RECEIVED
  ESTIMATED
  APPROVED
  IN_REPAIR
  QC_READY
  DELIVERED
}

// ─────────────────────────────────────────────────────────────────────────────
// Shift & Day Closing Management
// ─────────────────────────────────────────────────────────────────────────────

model Shift {
  id            String       @id @default(cuid())
  tenantId      String
  branchId      String
  userId        String
  shiftNumber   Int
  openedAt      DateTime     @default(now())
  closedAt      DateTime?
  openingCash   Decimal      @db.Decimal(10, 2)
  expectedCash  Decimal?     @db.Decimal(10, 2)
  actualCash    Decimal?     @db.Decimal(10, 2)
  cashVariance  Decimal?     @db.Decimal(10, 2)
  isLocked      Boolean      @default(false)
  approvedById  String?
  notes         String?

  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  branch        Branch       @relation(fields: [branchId], references: [id])
  user          User         @relation("ShiftUser", fields: [userId], references: [id])
  approvedBy    User?        @relation("ShiftApprover", fields: [approvedById], references: [id])
  dayClosing    DayClosing?

  @@index([tenantId, branchId, openedAt])
}

model DayClosing {
  id                 String    @id @default(cuid())
  tenantId           String
  branchId           String
  shiftId            String    @unique
  closeDate          DateTime  @default(now())
  totalSalesAmount   Decimal   @db.Decimal(12, 2)
  totalCashSales     Decimal   @db.Decimal(10, 2)
  totalDigitalSales  Decimal   @db.Decimal(10, 2)
  totalOldGoldCash   Decimal   @db.Decimal(10, 2) @default(0)
  totalExpenses      Decimal   @db.Decimal(10, 2) @default(0)
  goldWeightSold     Decimal   @db.Decimal(10, 3) @default(0)
  isApproved         Boolean   @default(false)

  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  branch             Branch    @relation(fields: [branchId], references: [id])
  shift              Shift     @relation(fields: [shiftId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Store Settings & Statutory Compliance Configuration
// ─────────────────────────────────────────────────────────────────────────────

model StoreSetting {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  tradeLegalName     String?
  bisLicenseNumber   String?
  ahcCenterName      String?
  invoicePrefix      String   @default("INV-2026-")
  estimatePrefix     String   @default("EST-2026-")
  goldGstPercent     Decimal  @db.Decimal(5, 2) @default(3.0)
  makingGstPercent   Decimal  @db.Decimal(5, 2) @default(5.0)
  cashPanLimit       Decimal  @db.Decimal(10, 2) @default(200000)
  enforceHuid        Boolean  @default(true)
  allowNegativeStock Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  tenant             Tenant   @relation(fields: [tenantId], references: [id])
}
